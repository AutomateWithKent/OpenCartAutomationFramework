<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="CrossBrowserDDTSuite" thread-count="3">

<groups>
	<run>
		<include name="datadriven"></include> <!--
      used grouping for datadriver
    -->
	</run>
</groups>

<listeners>
	<listener class-name="utilities.ExtentReportUtils"></listener>
</listeners>

  <test name="DataDrivenTest">
    <parameter name="browser" value="chrome"></parameter>
    <parameter name="os" value="linux"></parameter>
    <classes>
      <class name="testCases.TC_RF_001_AccountRegistrationTest"></class>
      <class name="testCases.TC_RF_003_AccountRegistrationTest"></class>
      <class name="testCases.TC_LF_001_LoginTest"></class>
      <class name="testCases.TC_003_LoginDTT"></class>  
      <class name="testCases.TC_SF_001_SearchTest"></class>
      <class name="testCases.TC_ATC_001_AddToCartTest"></class>
      <class name="testCases.TC_PC_001_ProductCompareTest"></class>
    </classes>
  </test>
  
